NODE_ENV=production
PORT=3000

# Supabase project values. Keep the service role key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Optional aliases if you prefer Supabase's newer key names.
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key

SUPABASE_STORAGE_BUCKET=papers
SIGNED_URL_TTL_SECONDS=900

# Comma-separated, exact HTTPS origins allowed to call the production API.
# Do not include paths, trailing slashes, wildcards, file://, or "null".
FRONTEND_URL=https://your-domain.example

# Express proxy trust. Use 1 for most single-proxy Node hosts. Use false only
# when the app is reached directly; never use bare true.
TRUST_PROXY=1

# Optional comma-separated admin allowlist. A server-managed
# app_metadata.role="admin" is also accepted; user_metadata is never trusted.
ADMIN_EMAILS=admin@example.com

# HTTPS recovery URL. Its origin must also appear in FRONTEND_URL.
PASSWORD_RESET_REDIRECT_URL=https://your-domain.example/reset-password.html
