PORT=3000
NODE_ENV=development

# Add your Supabase project values here.
SUPABASE_URL=https://your-project-ref.supabase.co
# You can use the new Supabase keys here:
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Optional aliases if you prefer Supabase's new names:
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=papers

# Comma-separated origins allowed to call this API.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Admin page secret. Use a long random value in production.
ADMIN_API_KEY=change-this-long-random-secret

# Comma-separated admin emails. These Supabase users can access admin.html after admin login.
ADMIN_EMAILS=admin@example.com

# Optional: where Supabase sends users after password reset.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password.html
